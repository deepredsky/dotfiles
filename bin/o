#!/usr/bin/env bash
# Browse Firefox bookmarks with fzf and open the selected one.
set -e

source "$(dirname "$0")/lib/platform.sh"

command -v sqlite3 >/dev/null 2>&1 || { echo "sqlite3 is required" >&2; exit 1; }
command -v fzf >/dev/null 2>&1 || { echo "fzf is required" >&2; exit 1; }

if os_is_darwin; then
  base_dir="$HOME/Library/Application Support/Firefox"
else
  base_dir="$HOME/.mozilla/firefox"
fi

profiles_ini="$base_dir/profiles.ini"

default_profile_path() {
  awk '
    /^\[/ {
      if (is_default && path != "" && !found) { print path; found=1; exit }
      path=""; is_default=0; next
    }
    /^Path=/ { sub(/^Path=/, ""); path=$0 }
    /^Default=1/ { is_default=1 }
    END { if (!found && is_default && path != "") print path }
  ' "$profiles_ini"
}

profile=""
if [ -f "$profiles_ini" ]; then
  rel_path=$(default_profile_path)
  [ -n "$rel_path" ] && profile="$base_dir/$rel_path"
fi

if [ -z "$profile" ] || [ ! -d "$profile" ]; then
  profile=$(find "$base_dir" -maxdepth 2 -type d -name '*.default-release' 2>/dev/null | head -n1)
fi
if [ -z "$profile" ]; then
  profile=$(find "$base_dir" -maxdepth 2 -type d -name '*.default*' 2>/dev/null | head -n1)
fi

if [ -z "$profile" ]; then
  echo "Could not find a Firefox profile in $base_dir" >&2
  exit 1
fi

db="$profile/places.sqlite"

# Read via a URI with immutable=1 so this works even while Firefox has the
# database open (no need to copy it first).
selection=$(sqlite3 -separator "$(printf '\t')" "file:${db}?immutable=1" "
  SELECT b.title, p.url
  FROM moz_bookmarks b
  JOIN moz_places p ON b.fk = p.id
  WHERE b.type = 1 AND b.title IS NOT NULL AND p.url IS NOT NULL
  ORDER BY b.title;
" | fzf --delimiter='\t' --with-nth=1)

[ -n "$selection" ] || exit 0

url=$(printf '%s' "$selection" | awk -F'\t' '{print $NF}')
open_default "$url"
