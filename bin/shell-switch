#!/usr/bin/env bash
# Usage: shell-switch [quickshell|waybar]  (no arg = last choice, default waybar)

set -e

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-shell"
choice="${1:-$(cat "$STATE" 2>/dev/null || echo waybar)}"

case "$choice" in
  quickshell|waybar) ;;
  *) echo "usage: shell-switch [quickshell|waybar]" >&2; exit 1 ;;
esac

mkdir -p "$(dirname "$STATE")"
echo "$choice" > "$STATE"

# Stop the running bar and swaync before starting the chosen one.
# NixOS wrappers rename processes to .foo-wrapped (comm is cut at 15 chars).
ps -eo pid=,comm= \
  | awk '$2 ~ /^\.?(waybar|swaync(-client)?|quickshell)(-wr|-?$)/ {print $1}' \
  | xargs -r kill
sleep 0.5

setsid -f "$choice" >/dev/null 2>&1
setsid -f swaync >/dev/null 2>&1
