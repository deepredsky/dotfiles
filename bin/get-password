#!/usr/bin/env bash
# Looks up a password from 1Password (works on both macOS and Linux).
# Usage: get-password <item-name>
#
# Expects a 1Password item named <item-name> (e.g. "personalmail", "work")
# with a "password" field, reachable by the `op` CLI (desktop app integration
# on macOS, or a signed-in `op` session on Linux).
set -e

account="$1"

if [ -z "$account" ]; then
  echo "Usage: $(basename "$0") <item-name>" >&2
  exit 1
fi

if ! command -v op >/dev/null 2>&1; then
  echo "1Password CLI (op) not found" >&2
  exit 1
fi

op item get "$account" --fields password --reveal
