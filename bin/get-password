#!/usr/bin/env bash
# Looks up a password for an account.
# Usage: get-password <item-name>
#
# macOS: reads the Keychain item named <item-name> (`security find-generic-password`).
# Linux: reads the 1Password item named <item-name> via the `op` CLI (signed-in session).
source "$(dirname "$0")/lib/platform.sh"

account="$1"

if [ -z "$account" ]; then
  echo "Usage: $(basename "$0") <item-name>" >&2
  exit 1
fi

if os_is_darwin; then
  /usr/bin/security find-generic-password -l "$account" -w
else
  if ! command -v op >/dev/null 2>&1; then
    echo "1Password CLI (op) not found" >&2
    exit 1
  fi

  op item get "$account" --fields password --reveal
fi
